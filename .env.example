# PostgreSQL
POSTGRES_DB=sia_qr
POSTGRES_USER=sia_qr
POSTGRES_PASSWORD=sia_qr
# "db" dentro de Docker (nombre del servicio), "localhost" ejecutando Django en el host
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Django
# OBLIGATORIA en producción (DEBUG=False): sin ella Django no arranca.
# En desarrollo (DEBUG=True) puede omitirse (fallback inseguro solo-local).
DJANGO_SECRET_KEY=change-me
# Default: False. Usa True solo en desarrollo local.
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# CORS (orígenes del SPA, coma-separados, con esquema)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# CSRF: orígenes de confianza (coma-separados). Si se omite, se deriva de
# CORS_ALLOWED_ORIGINS + FRONTEND_URL. Debe incluir el origen del frontend
# para que el POST con X-CSRFToken no sea rechazado (403 CSRF).
#CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Cookies Secure: default True en producción, False con DEBUG=True.
# Forzar a True solo si sirves HTTPS en local.
#COOKIE_SECURE=False
# SameSite de cookies de sesión/CSRF: default Lax (local). En producción
# cross-site (frontend y backend en dominios distintos) usar None para que
# el navegador las envíe en el fetch (exige Secure=True, ya activo en prod).
#COOKIE_SAMESITE=None

# m2: gracia previa (segundos) del QR automático antes del inicio (0-300).
# Fuente prioritaria: SystemConfig[EARLY_QR_GRACE_SECONDS] > este valor > 30.
#EARLY_QR_GRACE_SECONDS=30

# SIA-QR: URL pública del frontend (para construir /attend?token= del QR)
FRONTEND_URL=http://localhost:3000
# TTL por defecto (minutos) de las sesiones QR (1-120). Fuente prioritaria:
# SystemConfig[QR_DEFAULT_MINUTES] > settings.QR_DEFAULT_MINUTES > 10.
# El default del modelo ScheduledClass.qr_duration_minutes también es 10.
QR_DEFAULT_MINUTES=10

# Autenticación SPA (C1): SessionAuthentication estándar CON CSRF.
# Flujo frontend: GET /api/auth/csrf/ -> axios withXSRFToken envía
# X-CSRFToken en POST/PATCH/PUT/DELETE. Sin exenciones globales.

# Bootstrap prod sin shell (Render free): crea el superuser inicial en el
# build vía `createsuperuser --noinput`. Solo en el dashboard de Render,
# nunca commitear valores reales.
#DJANGO_SUPERUSER_EMAIL=admin@ut.edu.co
#DJANGO_SUPERUSER_PASSWORD=cambia-esta-clave
