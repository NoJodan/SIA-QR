# PostgreSQL
POSTGRES_DB=sia_qr
POSTGRES_USER=sia_qr
POSTGRES_PASSWORD=sia_qr
# "db" dentro de Docker (nombre del servicio), "localhost" ejecutando Django en el host
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000